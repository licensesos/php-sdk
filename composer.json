{
    "name": "licenseos/php-sdk",
    "description": "PHP SDK for LicenseOS - License validation and activation for PHP applications",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "LicenseOS Team",
            "email": "support@licenseos.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "LicenseOS\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LicenseOS\\Tests\\": "tests/"
        }
    },
    "homepage": "https://docs.licenseos.com/sdks/php",
    "support": {
        "source": "https://github.com/licenseos/php-sdk",
        "issues": "https://github.com/licenseos/php-sdk/issues"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
